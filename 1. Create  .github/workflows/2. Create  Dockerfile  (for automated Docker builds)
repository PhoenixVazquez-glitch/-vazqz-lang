FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json ./
RUN npm ci
COPY . .
# Auto-fix issues during build
RUN sed -i 's/const outFile = fullPath.replace(\\/\\.vz\\$/, ".wat");/const outFile = fullPath.replace(".vz", ".wat");/' src/cli.ts || true
RUN sed -i '1s/^/import os from "os";\nimport { execSync } from "child_process";\n/' src/pm/manager.ts || true
RUN sed -i '/const tar = require/d' src/pm/manager.ts || true
RUN sed -i '/const { execSync } = require/d' src/pm/manager.ts || true
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./
COPY --from=builder /app/examples ./examples
RUN npm ci --omit=dev
EXPOSE 4873
CMD ["node", "dist/pm/registry.js"]
