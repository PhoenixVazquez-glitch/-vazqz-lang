name: Auto Fix

on:
  push:
    branches-ignore: [main]

jobs:
  fix:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
      
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          
      - name: Auto-fix known issues
        run: |
          sed -i 's/const outFile = fullPath.replace(\\/\\.vz\\$/, ".wat");/const outFile = fullPath.replace(".vz", ".wat");/' src/cli.ts
          sed -i '1s/^/import os from "os";\nimport { execSync } from "child_process";\n/' src/pm/manager.ts
          sed -i '/const tar = require/d' src/pm/manager.ts
          sed -i '/const { execSync } = require/d' src/pm/manager.ts
          sed -i 's/pathname.match(\/^\\\/\[^\/\]\+\\\/\$\/) /pathname.split("\/").length === 2 \&\& pathname !== "\/" /' src/pm/registry.ts
          sed -i 's/pathname.match(\/^\\\/\[^\/\]\+\\\/-\\\/\.\*\\.tgz\\\/\$\/) /pathname.includes("\/-\/") \&\& pathname.endsWith(".tgz") /' src/pm/registry.ts
          
      - name: Commit fixes
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@github.com"
          git add -A
          git diff --quiet && git diff --staged --quiet || git commit -m "auto: fix known issues"
          git push
